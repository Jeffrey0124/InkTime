# 飞牛 NAS 上的真实照片目录。容器内会只读挂载到 /photos。
PHOTO_DIR=/vol1/你的照片目录

# 项目数据目录。photos.db、渲染结果、推送 BMP/PNG 都会写到这里。
DATA_DIR=/vol1/docker/inktime/data

FLASK_PORT=8766
PUSH_TIMEZONE=Asia/Shanghai
PUSH_SCHEDULES=07:00,12:00,18:40
PUSH_EXCLUDE_DAYS=90
INKTIME_PUSH_API_TOKEN=change-me

# WebUI 单管理员首次登录。密码至少 8 个字符，会话密钥至少使用 32 个随机字符。
INKTIME_ADMIN_INITIAL_PASSWORD=
INKTIME_SESSION_SECRET=
# 仅当 WebUI 全程通过 HTTPS 访问时设为 true；纯局域网 HTTP 保持 false。
INKTIME_AUTH_COOKIE_SECURE=false

# WebUI 中保存模型 API Key 时使用。请设置为独立的高强度随机值；未配置时
# 服务仍可启动，但只能引用环境变量中的凭据，不能把密钥写入数据库。
INKTIME_SETTINGS_MASTER_KEY=

# 素材库扫描。排除规则使用相对于照片根目录的 glob，以逗号分隔。
SCAN_ON_STARTUP=true
SCAN_INTERVAL_MINUTES=30
SCAN_EXCLUDE_PATTERNS=private/**,exports/**

# NAS 容器里不能用 127.0.0.1 访问你电脑上的 LM Studio。
# 请改成电脑在局域网里的固定 IP，例如 http://192.168.1.50:9100/v1/chat/completions。
LOCAL_VLM_API_URL=http://192.168.1.50:9100/v1/chat/completions
LOCAL_VLM_API_KEY=
LOCAL_VLM_MODEL=google/gemma-4-31b-qat:2
LOCAL_VLM_TIMEOUT=60

CLOUD_QWEN_API_URL=https://llm-prkpw0ryls2lv0zy.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
CLOUD_QWEN_API_KEY=填入你的云端API_KEY
CLOUD_QWEN_MODEL=qwen3-vl-plus
CLOUD_QWEN_TIMEOUT=600

BATCH_LIMIT=30
DAILY_PHOTO_QUANTITY=5
